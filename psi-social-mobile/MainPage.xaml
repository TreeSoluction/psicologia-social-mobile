<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title=""
             x:Class="psi_social_mobile.MainPage">

    <StackLayout VerticalOptions="Start">
        <StackLayout Padding="10">
            <Button HorizontalOptions="Start" Text="Configurar Disponibilidade" />
        </StackLayout>
        
        <StackLayout VerticalOptions="CenterAndExpand" Margin="0,50,0,0">
            <Image MaximumHeightRequest="150" Source="Resources/Images/p.png"></Image>
        </StackLayout>

        <StackLayout Padding="30" VerticalOptions="FillAndExpand" Margin="0,50,0,0">
            <StackLayout VerticalOptions="CenterAndExpand" Spacing="40"> 
            <StackLayout>
                <Label FontSize="25">Sou Psicologo...</Label>
                <Button HeightRequest="60" Text="Quero Ajudar" Clicked="Button_Clicked_1"></Button>
            </StackLayout>
            <StackLayout>
                <Label FontSize="25">Sou Paciente...</Label>
                <Button HeightRequest="60" Text="Preciso de Ajuda"></Button>
            </StackLayout>
                
            </StackLayout>
        </StackLayout>
    </StackLayout>

</ContentPage>
