<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="psi_social_mobile.PosRegister"
             Title="">
    <ContentPage.Content>
        <StackLayout Padding="20,20,20,20">
            <Label FontSize="22">
                Parabens! Seu cadastro foi concluído com sucesso!
            </Label>
            <Label FontSize="22" Margin="0,10,0,0">
                Em breve você receberá pedidos de ajuda no número cadastrado.
            </Label>
            <StackLayout Margin="0,50,0,0">
                <Image MaximumHeightRequest="150" Source="Resources/Images/p.png"></Image>
            </StackLayout>
            <Label FontSize="22" HorizontalTextAlignment="Center" Margin="0,20,0,0">
                Agradece pela sua Ajuda!
            </Label>
            <StackLayout VerticalOptions="EndAndExpand" Padding="0,0,0,40">
                    <Button BackgroundColor="SteelBlue" Text="Voltar" Clicked="Button_OnClicked"/>
            </StackLayout>
            </StackLayout>
    </ContentPage.Content>
</ContentPage>